# Copie este arquivo para "backend/.env" e preencha com os dados do seu banco.
# O arquivo .env NÃO é enviado para o GitHub (está no .gitignore).

# MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/pokedex?retryWrites=true&w=majority

# MongoDB local (docker compose up -d):
MONGODB_URI=mongodb://localhost:27017/pokedex
MONGODB_DATABASE=pokedex
